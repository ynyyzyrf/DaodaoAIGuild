# 本地开发环境变量示例（复制为 .env）
DATABASE_URL=mysql+asyncmy://daodao:daodao@localhost:3306/daodao
JWT_SECRET=please-change-me
DEBUG=true

# OMEACCOUNT 后端 token 校验：前端拿到 OME access_token 后，后端用 employee-info 换成本系统 session
OME_EXTERNAL_API_BASE=https://hrsaastest-1-api.wiltechs.com
OME_EMPLOYEE_INFO_ENDPOINT=/api/user/employee-info
# OME_LANGUAGE=zh-CN
# OME_TENANT_ID=
# OME_PLATFORM=web

# PM Desktop API；真实 key 只放本地/部署环境，不提交到代码库。
PM_DESKTOP_API_BASE=https://pmdesktop.daodaoagi.com
PM_DESKTOP_API_KEY=
PM_DESKTOP_REQUEST_TIMEOUT_SECONDS=10
