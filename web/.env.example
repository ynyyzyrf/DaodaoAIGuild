# 服务端 SSR 直连后端地址
API_INTERNAL_URL=http://api:8000

NEXT_PUBLIC_OME_AUTHORIZATION_API=https://ome-account.wiltechs.com
NEXT_PUBLIC_OME_PASSWORD_FLOW_APP_ID=YOUR_CLIENT_ID
# Pure Frontend 模式会把该值暴露到浏览器；如 OME client 不需要 secret，可留空。
NEXT_PUBLIC_OME_PASSWORD_FLOW_APP_SECRET=YOUR_CLIENT_SECRET
NEXT_PUBLIC_OME_PASSWORD_FLOW_SCOPES=incubation_road offline_access openid email phone profile

# 仅本地开发需要旧账号密码登录时设为 true；生产环境不要开启。
NEXT_PUBLIC_ENABLE_LOCAL_LOGIN=false
